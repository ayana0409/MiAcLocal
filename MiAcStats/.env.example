# Copy to ".env" (gitignored) before running Docker Compose or local go run.

PORT=8080
TURSO_DATABASE_URL=https://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Device & Timezone
DEFAULT_DEVICE_ID=miac-main
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Run mode
DEMO_MODE=false

# Non-Inverter power draw profile (Watts) and tariff defaults
COOL_WATTS=700
FAN_LOW_WATTS=30
FAN_HIGH_WATTS=50
TARIFF_MODE=evn
FLAT_RATE_VND=3000
VAT_PERCENT=8
BASE_HOME_KWH=100

# QuickBite SSO Authentication (OpenIddict)
SSO_ENABLED=true
SSO_IDENTITY_URL=https://identity.thuandd.io.vn
SSO_CLIENT_ID=QuickBite_Portal
SSO_CLIENT_SECRET=your_sso_client_secret_here
SSO_SCOPE=openid profile email roles offline_access Identity
# Generate random 32-byte string or hex for AES-256 session cookie encryption
SESSION_SECRET=replace_with_a_secure_random_string_in_production
SECURE_COOKIE=true
SESSION_MAX_AGE_SECONDS=1209600
